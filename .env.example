# Server Configuration
PORT=5000
NODE_ENV=development
MAX_FILE_SIZE_MB=5

# CORS Allowed Origins (* allows all origins including Vercel frontend deployments)
CORS_ORIGIN=*

# LLM Provider Configuration
# Supported providers: "gemini" (recommended, free tier) or "groq" (fast free tier)
LLM_PROVIDER=gemini

# Google Gemini API Settings (Free tier available at https://aistudio.google.com/)
# Free tier offers: 15 Requests/min, 1M Tokens/min, 1,500 Requests/day
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq API Settings (Free tier available at https://console.groq.com/)
# Alternative ultra-fast free provider
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend Vercel Environment Variable:
# Set this in Vercel to your deployed Render backend URL:
# VITE_API_BASE_URL=https://ai-resume-analyzer-wfg8.onrender.com
