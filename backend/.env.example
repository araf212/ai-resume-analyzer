PORT=5000
NODE_ENV=development
MAX_FILE_SIZE_MB=5

# CORS Allowed Origins (default is * to allow all origins including Vercel)
# You can set to * or specific origins like: https://your-app.vercel.app
CORS_ORIGIN=*

# LLM Provider selection: "gemini" or "groq"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq API Key (Optional alternative from https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
